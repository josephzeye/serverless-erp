# =============================================================================
# Serverless E-commerce ERP — Environment Variables
# Copy this file to `.env.local` and fill in your credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Database & Auth)
# -----------------------------------------------------------------------------
# Public project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anonymous key (safe for browser, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (SERVER ONLY — bypasses RLS, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (migrations, admin scripts)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# PgBouncer pooled connection (SERVER ONLY — use in Serverless API routes)
# Transaction mode pooler port is typically 6543
SUPABASE_POOLED_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true

# -----------------------------------------------------------------------------
# Shopify Custom App
# -----------------------------------------------------------------------------
# Store domain (e.g. my-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from Custom App
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API version (keep aligned with Shopify changelog)
SHOPIFY_API_VERSION=2026-07

# GraphQL orders poll filter (optional)
# SHOPIFY_ORDERS_QUERY=fulfillment_status:unfulfilled OR fulfillment_status:partial

# Customer PII (email, shipping address) — Advanced/Plus plans only
# Basic plan MUST keep this false (default)
# SHOPIFY_INCLUDE_PII=false

# Webhook HMAC secret (from Shopify webhook registration)
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-secret

# -----------------------------------------------------------------------------
# Google Sheets — Supplier / WMS Integration
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com

# Private key from service account JSON (escape newlines as \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Target spreadsheet ID (from URL)
GOOGLE_SHEET_ID=your-google-sheet-id

# Sheet tab names
GOOGLE_SHEET_PENDING_ORDERS_TAB=Pending_Orders

# -----------------------------------------------------------------------------
# Vercel Cron & Security
# -----------------------------------------------------------------------------
# Secret sent as Authorization: Bearer <CRON_SECRET> by Vercel Cron
CRON_SECRET=your-random-cron-secret

# App base URL (used for internal callbacks)
# Local: http://localhost:3000
# Vercel Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel auto-injected (do not set manually)
# VERCEL_ENV=production|preview|development
# VERCEL_URL=xxx.vercel.app

# -----------------------------------------------------------------------------
# Financial / Analytics Defaults
# -----------------------------------------------------------------------------
# Base currency for profit normalization
BASE_CURRENCY=USD

# Shopify payment processing fee (default: 2.9% + $0.30 USD)
SHOPIFY_PLATFORM_FEE_RATE=0.029
SHOPIFY_PLATFORM_FEE_FIXED=0.30

# Fallback supplier cost when inventory.unit_supplier_cost is 0 (55% of retail)
SUPPLIER_COST_RATIO=0.55

# Exchange rate API (optional — for multi-currency profit analysis)
EXCHANGE_RATE_API_KEY=

# Network proxy (required if googleapis.com / supabase.co blocked, e.g. mainland China)
# Use your VPN/clash local HTTP proxy port — affects Supabase + Google APIs
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
